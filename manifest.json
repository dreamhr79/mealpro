{
  "manifest_version": 3,
  "name": "CijeneMeal Pro — Obroci, Makronutrijenti & HR Cijene",
  "version": "3.2.2",
  "description": "Kalkulator obroka, Dnevni plan, pametni popis za kupovinu, uvoz recepata s Instagrama i cjenici s cijene.dev.",
  "permissions": [
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://api.cijene.dev/*",
    "https://*.cijene.dev/*",
    "https://world.openfoodfacts.org/*",
    "https://api.nal.usda.gov/*",
    "https://*.instagram.com/*",
    "https://instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CijeneMeal Pro"
  },
  "options_page": "app.html"
}